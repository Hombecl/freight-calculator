# DimPack3D — optional backend config.
# The app runs fully WITHOUT these (falls back to the client-side lead-capture
# export gate). Set them to turn on real accounts + the secure Pro paywall.

# Supabase (use a DEDICATED project for this public app, not an internal DB)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Lemon Squeezy hosted checkout URL (Buy button link for the Pro variant)
VITE_LS_CHECKOUT_URL=

# Optional: POST lead emails from the free export gate to this endpoint
# (Formspree, a Supabase Edge Function, etc.). Leave blank to store locally only.
VITE_LEAD_ENDPOINT=

# --- server-side only (NOT prefixed VITE_, never shipped to the browser) ---
# Set these as Supabase Function secrets, not in this file:
#   supabase secrets set LS_WEBHOOK_SECRET=...
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically.
